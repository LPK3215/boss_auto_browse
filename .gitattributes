# Auto detect text files and normalize line endings
* text=auto

# PowerShell scripts use CRLF (Windows native)
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Markdown and text files use LF
*.md text eol=lf
*.txt text eol=lf

# Binary files
*.exe binary
*.dll binary
*.png binary
*.jpg binary
*.ico binary
